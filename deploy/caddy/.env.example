# Copy to .env in the same folder as docker-compose.yml.
#
# These are read by docker compose and passed into Caddy, which substitutes
# {$VAR} in the Caddyfile. Change the domains to yours; every one needs an A
# record pointing at this server's public IP BEFORE you start Caddy, or the
# certificate request fails and Caddy retries with a backoff.

ACME_EMAIL=admin@7softwarejo.com

ERP_DOMAIN=erp.7softwarejo.com
DASHBOARD_DOMAIN=app.7softwarejo.com
API_DOMAIN=api.7softwarejo.com
