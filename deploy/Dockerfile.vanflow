# VanFlow — backend + office dashboard in ONE image.
#
# For an on-prem client who runs a single box AND already runs their own ERP:
# 94.142.51.91 has erp-app/erp-db of its own, which the VanFlow upgrade leaves
# alone, so the three-app Dockerfile.suite would put a second ERP beside it.
# This is that image minus the ERP. Everything else is deliberately identical —
# same stages, same runtime layout, same trade-off at the bottom.
#
# Build from the PARENT of the two repos, so both sources are in context:
#   docker build -f cash-van-dashboard/deploy/Dockerfile.vanflow \
#                -t vanflow:prod  /Users/…/7Software
#
# No staging step: the entrypoint is copied from its real path, and BuildKit
# reads the ignore rules from Dockerfile.vanflow.dockerignore beside this file.
#
# Ports inside the container (both default to 3000 on their own, which is
# exactly the collision this file has to resolve):
#   3100  backend          (NestJS)
#   3001  office dashboard (Next.js)

ARG NODE_VERSION=20-alpine

# ─────────────────────────────────────────────────────────────────────────────
# Backend (NestJS)
# ─────────────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS be-deps
WORKDIR /app
COPY cash-van-dashboard/package.json cash-van-dashboard/package-lock.json ./
RUN npm ci

FROM node:${NODE_VERSION} AS be-build
WORKDIR /app
ENV NODE_ENV=production
COPY --from=be-deps /app/node_modules ./node_modules
COPY cash-van-dashboard/ ./
# prune AFTER building: the build needs devDependencies (nest cli, typescript).
RUN npm run build && npm prune --omit=dev

# ─────────────────────────────────────────────────────────────────────────────
# Office dashboard (Next.js)
# ─────────────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS fe-deps
WORKDIR /app
COPY cash-van-dashboard-frontend/package.json cash-van-dashboard-frontend/package-lock.json ./
RUN npm ci

FROM node:${NODE_VERSION} AS fe-build
WORKDIR /app
# NEXT_PUBLIC_* are inlined into the browser bundle at BUILD time, so these are
# the URLs the BROWSER will use.
#
# They default to RELATIVE, unlike Dockerfile.suite's localhost defaults, because
# this image is built for a Caddy-fronted client: the dashboard and the API are
# served from one origin, so "/api/v1" and a same-origin websocket work on every
# host without baking a hostname in. One image ships to any client. Override the
# args only for a deployment that genuinely serves them from different origins.
ARG NEXT_PUBLIC_API_BASE_URL=/api/v1
ARG NEXT_PUBLIC_WS_URL=
ARG NEXT_PUBLIC_AI_ENABLED=false
ARG NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Left as a placeholder and substituted at RUNTIME by the entrypoint, so one
# image can ship to clients with different keys.
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=__RUNTIME_GOOGLE_MAPS_API_KEY__
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_AI_ENABLED=$NEXT_PUBLIC_AI_ENABLED \
    NEXT_PUBLIC_DEFAULT_LOCALE=$NEXT_PUBLIC_DEFAULT_LOCALE \
    NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=fe-deps /app/node_modules ./node_modules
COPY cash-van-dashboard-frontend/ ./
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Runtime — both, one container
# ─────────────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS runtime
RUN apk add --no-cache libc6-compat tini curl
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1

# One unprivileged user for both. They share a container, so isolating them from
# each other here would be theatre — the boundary that matters is the
# container's.
RUN addgroup -g 1001 -S vanflow && adduser -S vanflow -u 1001 -G vanflow

WORKDIR /srv

# Backend → /srv/backend
COPY --from=be-build --chown=vanflow:vanflow /app/dist ./backend/dist
COPY --from=be-build --chown=vanflow:vanflow /app/node_modules ./backend/node_modules
COPY --from=be-build --chown=vanflow:vanflow /app/package.json ./backend/
# The Arabic font for PDF reports. Not compiled, so `dist` does not carry it —
# without this line every Arabic PDF renders as empty boxes in production while
# looking perfect in development.
COPY --from=be-build --chown=vanflow:vanflow /app/assets ./backend/assets

# The uploads root (customer photos, attachments, agent reports). It must exist
# in the image, owned by the runtime user, BEFORE a named volume is mounted on
# it: Docker copies the directory's ownership into a fresh volume, whereas a
# mount point the image lacks is created root-owned and every upload then dies
# with EACCES. STORAGE_LOCAL_ROOT defaults to it.
RUN mkdir -p /srv/backend/storage && chown vanflow:vanflow /srv/backend/storage

# Dashboard → /srv/dashboard
COPY --from=fe-build --chown=vanflow:vanflow /app/.next/standalone ./dashboard/
COPY --from=fe-build --chown=vanflow:vanflow /app/.next/static ./dashboard/.next/static
COPY --from=fe-build --chown=vanflow:vanflow /app/public ./dashboard/public

# Copied from its real path in the repo, NOT from the context root.
#
# Dockerfile.suite expects suite-entrypoint.sh staged at the context root, which
# means copying a file into the parent of three repos before every build and
# remembering to remove it. Naming the real path costs nothing and makes the
# build a single command with no setup step.
COPY --chown=vanflow:vanflow cash-van-dashboard/deploy/vanflow-entrypoint.sh /srv/vanflow-entrypoint.sh
RUN chmod +x /srv/vanflow-entrypoint.sh

USER vanflow
EXPOSE 3001 3100

# tini as PID 1: two background node processes in one container orphan their
# children on exit, and without an init that reaps them the container
# accumulates zombies until it runs out of process slots.
ENTRYPOINT ["/sbin/tini", "--", "/srv/vanflow-entrypoint.sh"]

# Healthy only when the BACKEND answers — it is the one the dashboard and the
# vans depend on. A container whose dashboard is up but whose API is dead is not
# serving anyone, and should not report healthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3100/api/v1/health || exit 1

# ── Trade-off, stated plainly ────────────────────────────────────────────────
# Two apps in one container means they share a lifecycle: either one crashing
# takes the container down (by design — see the entrypoint), and you cannot
# restart or scale one without the other. That is the right shape for a single
# on-prem box and the wrong shape for anything cloud-hosted, where the separate
# images and a compose file are the better answer.
