# Copy to .env.vanflow and fill in the secrets, then:
#   docker compose -f docker-compose.vanflow.yml --env-file .env.vanflow up -d --build

# ── Postgres ─────────────────────────────────────────────────────────────────
DB_USERNAME=cashvan
DB_PASSWORD=cashvan_dev_pw
DB_NAME=cashvan

# ── Backend auth / security (required — no default) ─────────────────────────
# Generate on Windows PowerShell:
#   -join ((48..57)+(97..102)|Get-Random -Count 40|%{[char]$_})
# or with Git Bash / WSL:  openssl rand -hex 32
JWT_SECRET=
PHONE_HASH_SECRET=

# ── Backend optional ─────────────────────────────────────────────────────────
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:3002
JOFOTARA_MOCK=true
JOFOTARA_KMS_KEY=
JOBS_ENABLED=true
# Only set if this stack also talks to a running ERP instance.
ERP_WEBHOOK_SECRET=
# AI report agent — leave blank to disable, the API still boots fine.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ── Frontend (baked into the browser bundle at BUILD time — rebuild to change) ─
FE_API_BASE_URL=http://localhost:3001/api/v1
FE_WS_URL=http://localhost:3001
NEXT_PUBLIC_AI_ENABLED=false
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
