# tarball — build artifacts, not source.
dist-windows/
dist-windows-update/

# Linux-client (94.142.51.91 / 77.245.5.113) image bundles from
# scripts/build-94-images.sh — large docker image tarballs, build artifacts.
dist-94/
dist-77/

